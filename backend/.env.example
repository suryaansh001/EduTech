# ==========================================
# EduTech Backend Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual values

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://username:password@localhost:5432/edutech_db"

# ==========================================
# REDIS (Caching & Sessions)
# ==========================================
# Local Redis (development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Redis Cloud (production) - uncomment and use if needed
# REDIS_HOST=redis-xxxxx.c61.us-east-1-3.ec2.redns.redis-cloud.com
# REDIS_PORT=10774
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-redis-cloud-password

# ==========================================
# JWT (JSON Web Tokens)
# ==========================================
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="24h"

# ==========================================
# CLOUDINARY (File Storage)
# ==========================================
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==========================================
# EMAIL (NodeMailer)
# ==========================================
# For Gmail: Enable 2FA and generate App Password
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="EduTech Platform <noreply@edutech.com>"

# Alternative: SendGrid
# EMAIL_HOST="smtp.sendgrid.net"
# EMAIL_USER="apikey"
# EMAIL_PASS="your-sendgrid-api-key"

# ==========================================
# FRONTEND URL
# ==========================================
CLIENT_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# FILE UPLOAD
# ==========================================
# Maximum file size in bytes (10MB = 10485760)
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

# ==========================================
# SECURITY
# ==========================================
# Bcrypt rounds (10-12 recommended)
BCRYPT_ROUNDS=10

# ==========================================
# LOGGING
# ==========================================
# Log levels: error, warn, info, http, verbose, debug
LOG_LEVEL=info
